#!/bin/bash
# ============================================================================
# NCI Gadi PBS job: RSR IEEE 57-bus blackout demo (gpuvolta, 2x V100 + 24 CPU).
# Conventions taken from the working run_rsr.sh in this folder (project n74).
# Submit with:  qsub nci_gadi.pbs
#
# gpuvolta allocates 12 CPUs + ~95.5 GB per GPU, so ngpus=2 -> ncpus=24 /
# mem=191GB (half a node). For a full node use ngpus=4 / ncpus=48 / mem=382GB.
# Check the venv path / project / storage mounts below before submitting.
# ============================================================================
#PBS -M hyeuk.ryu@ga.gov.au
#PBS -m e
#PBS -P n74
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ngpus=2
#PBS -l ncpus=24
#PBS -l mem=191GB
#PBS -l jobfs=12GB
#PBS -l wd
#PBS -l storage=scratch/y57+scratch/n74+gdata/n74
#PBS -l other=hyperthread
#PBS -N rsr_ieee118

module load python3/3.12.1
module load cuda
source /g/data/n74/hxr547/tsum/.venv/bin/activate     # torch + scipy + typer

RSR_ROOT=/scratch/n74/hxr547/rsr                       # rsr checkout on Gadi
cd "$RSR_ROOT/demos/ieee118_blackout"

echo "Job $PBS_JOBID on $(hostname): GPUs=[${CUDA_VISIBLE_DEVICES:-none}] NCPUS=${PBS_NCPUS:-?}"

# --devices auto  -> the GPUs PBS allocated (2 here) for multi-GPU sampling.
# --n-workers     -> CPU processes for sfun + minimisation. With -l other=hyperthread
#                    you can oversubscribe past ncpus (run_rsr.sh used 96 on ncpus=24);
#                    48 = one worker per logical thread. Use -1 for PBS_NCPUS (=24).
# --runs 50       -> repeat the extraction 50x for a run-to-run distribution
#                    (summary.json + all_metrics.json). Drop it for a single run.
# 304 components make this the hardest IEEE case; on a GPU node a tight absolute
# gap is reachable, but it may take many rounds. Loosen --unk-thres (or use
# --unk-opt rel) if you want a quicker bracketed estimate.

COMMON="--runs 1 --devices auto --n-workers 96 --max-refs 10000 \
        --batch 100000 --unk-opt abs --unk-thres 1e-6 \
        --coverage-aware --ca-n-orders 4 --ca-n-seeds 48 --ca-max-add 48"

python run_demo.py $COMMON --ca-failure-beta 0 --out cov_fw/beta0 &> "$PBS_JOBID.beta0.log"
#python run_demo.py $COMMON --ca-failure-beta 2 --out cov_fw/beta2 &> "$PBS_JOBID.beta2.log"
#python run_demo.py $COMMON --ca-failure-beta 4 --out cov_fw/beta4 &> "$PBS_JOBID.beta4.log"



