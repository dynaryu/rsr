#    --runs 5 \
#    --devices auto \
#    --n-workers 48 \
#    --max-refs 100_000 \
#    --unk-opt abs --unk-thres 1.0e-5 \
#    --n-sample 10000000 --batch 100000 \
#    --out "$RSR_ROOT/demos/ieee118_blackout/out_nci2" \
#    &> "$PBS_JOBID.log"
